# Public URL of this server (no trailing slash). Applicants visit this; Slack + Google call back to it.
BASE_URL=https://philo-interviews.example.com
PORT=3000
TIMEZONE=America/New_York
DB_PATH=data/philo.db

# 32+ random characters. Generate with: openssl rand -hex 32
# Changing it later disconnects everyone's Google Calendar (tokens are encrypted with it).
SESSION_SECRET=

# Slack app (see slack-manifest.yml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
# Optional: set an app-level token (xapp-..., scope connections:write) to use Socket Mode for local dev.
SLACK_APP_TOKEN=
# Slack member id of the First Censor (admin). Only used the first time; after that use /philo censor @someone.
FIRST_CENSOR_SLACK_ID=U0123456789

# Google Cloud OAuth client (type: Web application)
# Authorized redirect URI: ${BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email digests of sign-ups/cancellations/moves to the First Censor.
# SMTP connection URL. Unset => emails are only logged to the console (and stay pending).
# Gmail example (note the @ in the username is written %40):
#   SMTP_URL=smtps://philo.interviews%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
# App password: turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords (paste it without spaces).
SMTP_URL=
EMAIL_FROM=Philo Interviews <no-reply@philomathean.org>
DIGEST_TO=firstcensor@philomathean.org
# Local hour (0-23, in TIMEZONE) the daily digest is sent.
DIGEST_HOUR=8
# A change to an interview starting within this many hours is emailed immediately (subject starts with URGENT:).
URGENT_WINDOW_HOURS=24
